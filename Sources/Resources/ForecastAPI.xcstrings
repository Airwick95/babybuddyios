    "Requests run only when you tap Request API estimate on Home. Your provider may charge fees and retain data under its own policy. A request to disable storage is sent, but the app cannot guarantee the provider's retention behavior.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests run only when you tap Request API estimate on Home. Your provider may charge fees and retain data under its own policy. A request to disable storage is sent, but the app cannot guarantee the provider's retention behavior."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfragen starten nur, wenn du auf der Startseite „API-Schätzung anfordern“ antippst. Dein Anbieter kann Gebühren berechnen und Daten nach seinen eigenen Regeln speichern. Die Anfrage fordert ihn auf, die Speicherung zu deaktivieren. Die App kann sein Speicherverhalten jedoch nicht garantieren."
          }
        }
      }
    },
    "Save API configuration": {
      "extractionState": "manual",
      "localizations": {
