    "Enable data sharing in Own API settings before requesting an estimate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable data sharing in Own API settings before requesting an estimate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere die Datenfreigabe unter „Eigene API“, bevor du eine Schätzung anforderst."
          }
        }
      }
    },
    "Enter a complete OpenAI-compatible Chat Completions HTTPS URL and a model supported by your service. JSON-object responses are required. Use max_tokens only if your service requires that older field. No provider is selected automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a complete OpenAI-compatible Chat Completions HTTPS URL and a model supported by your service. JSON-object responses are required. Use max_tokens only if your service requires that older field. No provider is selected automatically."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die vollständige HTTPS-Adresse einer OpenAI-kompatiblen Chat-Completions-API und ein unterstütztes Modell an. Antworten im JSON-Objektformat sind erforderlich. Verwende max_tokens nur, wenn dein Dienst dieses ältere Feld benötigt. Es wird kein Anbieter automatisch ausgewählt."
          }
        }
      }
    },
    "Experimental model estimate, not a care schedule. Follow your baby's cues and your care plan.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental model estimate, not a care schedule. Follow your baby's cues and your care plan."
