{
  "sourceLanguage": "en",
  "strings": {
    "AI may produce a different estimate, but has not been shown to be more accurate. It cannot bypass missing-data checks or extend the calculated window. API estimates expire after five minutes or a data change.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI may produce a different estimate, but has not been shown to be more accurate. It cannot bypass missing-data checks or extend the calculated window. API estimates expire after five minutes or a data change."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI kann eine andere Schätzung liefern. Eine höhere Genauigkeit ist bisher nicht belegt. Sie kann Prüfungen auf fehlende Daten nicht umgehen und den berechneten Zeitraum nicht erweitern. API-Schätzungen verfallen nach fünf Minuten oder bei einer Datenänderung."
          }
        }
      }
    },
    "API comparison": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API comparison"
          }
